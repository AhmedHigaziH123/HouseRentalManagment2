<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/centerInside"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context="FragmentsAndActivities.LogIn">


    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_marginTop="30dp"
        android:layout_height="69dp"
        android:gravity="center"
        android:text="Login"
        android:textColor="@color/KingBlue"
        android:textSize="20dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/Email"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_email"
        android:gravity="center"
        android:textColor="@color/KingBlue"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="20dp">

    </com.google.android.material.textfield.TextInputEditText>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/Password"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/edit_text"
            android:drawableLeft="@drawable/ic_lock"
            android:drawableRight="@drawable/ic_closed_eye"
            android:gravity="center"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="@color/KingBlue"
            android:padding="12dp"
            android:textColorHint="@color/KingBlue"
            android:textSize="20dp">

        </com.google.android.material.textfield.TextInputEditText>


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/Renter"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_check"
        android:gravity="center"
        android:textColor="@color/KingBlue"
        android:hint="Renter"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="20dp">

    </com.google.android.material.textfield.TextInputEditText>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/Lessor"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_check"
        android:drawableRight="@drawable/ic_check"
        android:gravity="center"
        android:hint="Lessor"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textColor="@color/KingBlue"
        android:textSize="20dp">

    </com.google.android.material.textfield.TextInputEditText>


    <Button
        android:id="@+id/Login"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@color/KingBlue"
        android:text="Login"
        android:textSize="20dp"
        />

    <Button
        android:id="@+id/SignUp"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="204dp"
        android:backgroundTint="@color/KingBlue"
        android:text="SignUp"
        android:textSize="20dp" />


</LinearLayout>