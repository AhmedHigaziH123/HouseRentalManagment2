<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/edit_text"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/OwnerId1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OwnerId:"
            android:textSize="15sp"
            android:textColor="@color/KingBlue"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/OwnerId2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="______"
            android:textColor="@color/KingBlue"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/RenterId1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RenterId:"
            android:textColor="@color/KingBlue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/RenterId2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="______"
            android:textColor="@color/KingBlue"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/HouseId1"
            android:layout_width="match_parent"
            android:textColor="@color/KingBlue"
            android:layout_height="wrap_content"
            android:text="HouseId:"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/HouseId2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="______"
            android:textColor="@color/KingBlue"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>



    <Button
        android:id="@+id/Accept"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Accept"
        android:backgroundTint="@color/KingBlue"/>



</LinearLayout>