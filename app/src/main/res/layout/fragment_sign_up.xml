<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/centerindide1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context="FragmentsAndActivities.SignUp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center"
        android:text="SignUp"
        android:textColor="@color/KingBlue"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/Emaila"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_email"
        android:gravity="center"
        android:hint="Email"
        android:textColor="@color/KingBlue"
        android:inputType="textEmailAddress"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/Password1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

    </com.google.android.material.textfield.TextInputEditText>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/Password1"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_lock"
        android:drawableRight="@drawable/ic_closed_eye"
        android:gravity="center"
        android:hint="Password"
        android:textColor="@color/KingBlue"
        android:inputType="textPassword"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/UserName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

    </com.google.android.material.textfield.TextInputEditText>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/UserName"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_user"
        android:gravity="center"
        android:hint="UserName"
        android:textColor="@color/KingBlue"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/Phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

    </com.google.android.material.textfield.TextInputEditText>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/Phone"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_phone"
        android:gravity="center"
        android:hint="Phone"
        android:inputType="number"
        android:textColor="@color/KingBlue"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/SignUp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

    </com.google.android.material.textfield.TextInputEditText>
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/RenterId"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/personid"
        android:gravity="center"
        android:hint="if you are renter enter an id"
        android:inputType="text"
        android:textColor="@color/KingBlue"
        android:padding="10dp"
        android:textColorHint="@color/KingBlue"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/SignUp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

    </com.google.android.material.textfield.TextInputEditText>


    <Button
        android:id="@+id/SignUp"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="348dp"
        android:backgroundTint="@color/KingBlue"
        android:text="SignUp"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</LinearLayout>